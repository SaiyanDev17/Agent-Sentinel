# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Dialogflow CX Agent IDs (UUID format)
AIDASSIST_AGENT_ID=your-aidassist-uuid
QACOMMANDER_AGENT_ID=your-qacommander-uuid
DIALOGFLOW_AGENT_ID=your-aidassist-uuid
HR_AGENT_ID=your-hrassistant-uuid
IT_AGENT_ID=your-ithelpdesk-uuid
FINANCE_AGENT_ID=your-financeadvisor-uuid

# Arize Phoenix Configuration
PHOENIX_PROJECT_NAME=agent-sentinel
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_BASE_URL=https://app.phoenix.arize.com/s/your-space
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space/v1/traces

# Application Environment
APP_ENV=development
APP_PORT=8000

# Performance tuning
SCAN_CONCURRENCY=4
DIALOGFLOW_TIMEOUT_SECONDS=45
GEMINI_TIMEOUT_SECONDS=30
PHOENIX_EVAL_BATCH_SIZE=5
CACHE_DEFAULT_TTL_SECONDS=3600
EVAL_CACHE_TTL_SECONDS=7200
MEMORY_CACHE_MAX_SIZE=2000

# Optional: Redis for multi-instance eval cache and job state
# REDIS_URL=redis://localhost:6379/0
