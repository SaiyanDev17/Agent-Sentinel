# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Dialogflow CX Agent IDs (UUID format)
AIDASSIST_AGENT_ID=your-aidassist-uuid
QACOMMANDER_AGENT_ID=your-qacommander-uuid
DIALOGFLOW_AGENT_ID=your-aidassist-uuid
HR_AGENT_ID=your-hrassistant-uuid
IT_AGENT_ID=your-ithelpdesk-uuid
FINANCE_AGENT_ID=your-financeadvisor-uuid

# Arize Phoenix Configuration
PHOENIX_PROJECT_NAME=agent-sentinel
PHOENIX_API_KEY=your-phoenix-api-key
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces

# Application Environment
APP_ENV=development
APP_PORT=8000
